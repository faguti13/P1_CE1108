$ Prueba: verifica reordenamiento de instrucciones; recibe: entradas y constantes del caso; genera: los resultados para comparar con .expect.
$ reorder_alu_lsu.oly - Bloque recto con cargas, ALU y guardas independientes:
$ --reorder adelanta las cargas (mas altas en el DAG) y mezcla ALU con LSU.

list ent a = [3, 1, 4, 1, 5, 9, 2, 6];
list ent b = [2, 7, 1, 8, 2, 8, 1, 8];
list ent c[8];
ent total = 0;

$ Hace: ejecuta y verifica el escenario de prueba; recibe: sin parametros; genera: cambios en variables de prueba.
vacio def main() {
    c[0] = a[0] * 2 + b[0];
    c[1] = a[1] * 3 - b[1];
    c[2] = a[2] + b[2] * 4;
    c[3] = a[3] - b[3] * 5;
    c[4] = (a[4] + b[4]) * 6;
    c[5] = (a[5] - b[5]) * 7;
    c[6] = a[6] * b[6] + 8;
    c[7] = a[7] * b[7] - 9;
    total = c[0] + c[1] + c[2] + c[3] + c[4] + c[5] + c[6] + c[7];
}
