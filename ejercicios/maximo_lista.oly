$ maximo_lista.oly - Recorre una lista y devuelve su elemento mayor.
$   maximo = 65

ent maximo = 0;
list ent datos = [3, 4, 5, 24, 5, 65, 46];

ent def maximo_lista(list ent lista, ent largo) {
    ent mayor = lista[0];
    para (ent i = 0; i < largo; i += 1) {
        si (lista[i] > mayor) {
            mayor = lista[i];
        }
    }
    retorno (mayor);
}

vacio def main() {
    maximo = llamar maximo_lista(datos, 7);
}
